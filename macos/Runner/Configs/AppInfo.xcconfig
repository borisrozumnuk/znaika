// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = Znaika

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = local.experiments.znaika

// The copyright displayed in application information
PRODUCT_COPYRIGHT = © 2026 Boris Rozumniuk

// Hardened runtime: macOS не даёт подсунуть приложению чужую библиотеку (DYLD_*-переменные,
// библиотеки других команд) и воспользоваться его разрешениями на микрофон и системный звук.
ENABLE_HARDENED_RUNTIME = YES
// Xcode добавляет в сборки с сертификатом разработчика право на отладку (get-task-allow):
// с ним любой процесс пользователя может подключиться к приложению отладчиком. В релизе не нужно.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS[config=Release] = NO

// Подпись. По умолчанию — «Sign to Run Locally» (без команды разработчика): проект
// собирается у любого. Своя команда — в Signing.local.xcconfig рядом (он не в git), например:
//   CODE_SIGN_STYLE = Manual
//   CODE_SIGN_IDENTITY = Apple Development
//   DEVELOPMENT_TEAM = XXXXXXXXXX
// С ней разрешения macOS (микрофон, системный звук) не слетают после каждой пересборки.
CODE_SIGN_STYLE = Automatic
#include? "Signing.local.xcconfig"
